bool actualEightyPercent(const V& p,const V& c){need(field(c,"Station")=="8","C1661_LITERAL_EIGHTY_PERCENT_COMMAND");const auto& first=f(p,"actual_first_pass_reported_speed");const auto& repeat=f(p,"actual_repeat_reported_speed");if(first.null()||repeat.null())return false;need(first.isNumber()&&repeat.isNumber(),"C1661_ACTUAL_SPEED_REPORT_TYPES");const auto a=std::stod(std::get<json::Number>(first.data).token),b=std::stod(std::get<json::Number>(repeat.data).token);need(std::isfinite(a)&&std::isfinite(b)&&a>=0&&b>=0,"C1661_ACTUAL_NONNEGATIVE_REPORTED_SPEED");if(a==0||b==0)return false;return std::abs(b-a*0.8)<=std::max(1.0,std::abs(a))*1e-9;}
bool literalFretboardReaction(const V& p,const V& c){const auto prompt=field(c,"Prompt");std::vector<int> targets;bool distinctRegisters=false,distinctPositions=false,ascendingRegisters=false;
 if(prompt=="Find degree 3 of C major in three registers"){targets={4,4,4};distinctRegisters=true;}
 else if(prompt=="Find b7 of A7 in three positions"){targets={7,7,7};distinctPositions=true;}
