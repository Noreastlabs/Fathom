bool chosenChordMembers(const V& values,const V& name){if(name.null())return false;const auto h=chord(text(name));bool good=true;const auto contacts=knownActualContacts(values,good);std::set<int> tones;for(const auto& value:contacts){good=good&&h.body.count(value.midi%12);tones.insert(value.midi%12);}for(int tone:h.quality)good=good&&tones.count(tone);return good;}
