 else if(prompt=="Play 1-3-5-7 of Dmaj7 from nearest position"){targets={2,6,9,1};const auto& reference=f(p,"actual_nearest_position_reference");if(reference.null()||!nonemptyTrimmedText(reference,1,4096))return false;}
 else if(prompt=="Transpose 1-b3-4-5 motif from A to C")targets={0,3,5,7};
 else {need(prompt=="Play same target in low/mid/high register","C1661_EXACT_LITERAL_REACTION_PROMPT");const auto& chosen=f(p,"actual_selected_target_note");if(chosen.null())return false;const int pitch=pc(text(chosen));targets={pitch,pitch,pitch};distinctRegisters=true;ascendingRegisters=true;}
 const auto& response=f(p,"actual_response_contacts");need(response.isArray()&&response.array().size()==targets.size(),"C1661_FULL_SOURCE_REACTION_RESPONSE");bool good=true;std::set<int> midi;std::set<std::pair<std::string,int>> positions;int previous=-1;for(std::size_t i=0;i<targets.size();++i){auto value=contact(response.array()[i]);if(!value){good=false;continue;}good=good&&value->midi%12==targets[i];if(distinctRegisters)good=good&&midi.insert(value->midi).second;if(distinctPositions)good=good&&positions.insert({value->string,value->fret}).second;if(ascendingRegisters)good=good&&previous<value->midi;previous=value->midi;}return good;}
