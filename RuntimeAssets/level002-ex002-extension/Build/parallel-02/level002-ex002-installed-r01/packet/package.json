      "sha256": "49ca027e8c7fee7b2c5437f93f8a5b5576e272e6cf888dbb1a82632749cec31a",
      "text": "SET 1 OF 9 - EXERCISES 001-012",
      "text_sha256": "239b1881cfc47b7066c6e07958e765815a8d0c156dd3f618706dc2d55330e51a"
    },
